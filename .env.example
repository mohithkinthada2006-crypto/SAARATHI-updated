# SAARATHI ENVIRONMENT CONFIGURATION
# Copy to .env for local development

# Map Provider (Default is high-performance OpenStreetMap with dark styling and zero API keys required)
VITE_MAP_PROVIDER=openstreetmap

# Routing & Directions Engine
# Options: 'simulated_osm' (built-in 60fps high-density geometry) | 'osrm' | 'openrouteservice'
VITE_ROUTING_PROVIDER=simulated_osm
VITE_ORS_API_KEY=your_openrouteservice_api_key_here

# Weather Intelligence Provider
# Options: 'simulated_india' (contextual monsoon/heat index) | 'openweathermap'
VITE_WEATHER_PROVIDER=simulated_india
VITE_OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Toll & FASTag API Gateway
VITE_TOLL_PROVIDER=nhai_fastag_mock
VITE_TOLL_API_KEY=your_toll_gateway_key_here

# EV Charging Network Aggregator (Tata EZ Charge, Jio-bp, Ather Grid, Statiq)
VITE_EV_PROVIDER=india_ev_mesh
